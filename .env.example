# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses Row Level Security — never prefix with NEXT_PUBLIC_,
# never import into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used to build absolute URLs for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI — Phase 2. SERVER ONLY, never exposed to the browser.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# Optional. Any slug from https://openrouter.ai/api/v1/models.
# Default: anthropic/claude-haiku-4.5
OPENROUTER_MODEL=


# ---------------------------------------------------------------------------
# Email (optional)
#
# Without these, quotes are still marked as sent and the console says plainly
# that nothing was delivered. With them, the customer gets the operator's own
# template from Settings, with the quote PDF attached.
#
# MAIL_FROM must be on a domain verified with the provider, or it is rejected.
# ---------------------------------------------------------------------------
RESEND_API_KEY=
MAIL_FROM="Busify <quotes@yourdomain.com>"

# --- Maps: address autocomplete and road distance -------------------------
# Optional. Without a token, one-shot geocoding and routing use OpenStreetMap
# public servers (Nominatim + OSRM) — no account needed, fair-use limits apply.
# Public Nominatim forbids autocomplete, so address suggestions need a key.
#
# Preferred. One key, with these three APIs enabled in Google Cloud:
#   Places API (New)  — the address typeahead and free-text geocoding
#   Routes API        — road distance and drive time between stops
# Restrict it to those APIs; it is used server-side only and is never sent to
# the browser, so an HTTP-referrer restriction would break it. Use an IP
# restriction, or none, and keep the API restriction tight.
GOOGLE_MAPS_API_KEY=
# Used only when GOOGLE_MAPS_API_KEY is empty.
MAPBOX_TOKEN=
# Force a provider. Only "mock" is useful here: it disables all network calls,
# which is what tests and offline development want.
GEO_PROVIDER=
