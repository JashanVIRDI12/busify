# ---------------------------------------------------------------------------
# Supabase — Project Settings > API
# ---------------------------------------------------------------------------
# Safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# SERVER ONLY. Bypasses Row Level Security — never prefix with NEXT_PUBLIC_,
# never import into a Client Component.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Used to build absolute URLs for auth email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# AI — Phase 2. SERVER ONLY, never exposed to the browser.
# ---------------------------------------------------------------------------
OPENROUTER_API_KEY=

# Optional. Any slug from https://openrouter.ai/api/v1/models.
# Default: anthropic/claude-haiku-4.5
OPENROUTER_MODEL=

# Slug of the single organization this deployment serves.
# Must match the row created by supabase/provision-viabus.sql.
VIABUS_ORG_SLUG=viabus
